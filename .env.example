# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Document every environment variable the crate, its tests, or its examples
# read — including optional ones — with a placeholder value and a comment
# saying what it is for. `.env.example` is the contract; `.env` is the secret.

# Log filter for the `tracing`/`env_logger` style ecosystem.
# RUST_LOG=info

# Backtraces for local debugging: 1 for a short backtrace, "full" for all frames.
# RUST_BACKTRACE=1

# Example of a credential a live/network-gated test would need. Tests that
# require one must skip cleanly when it is unset.
# EXAMPLE_API_KEY=replace-me

# The tinycomputer lab (scripts/lab). Jev and the optional LLM author both go
# through OpenRouter.
OPENROUTER_API_KEY=
# OpenRouter model the LLM author uses in `--mode authored`.
TINYCOMPUTER_LAB_MODEL=anthropic/claude-sonnet-5
# The only address `scripts/lab run mail-compose --send` will ever send to.
TINYCOMPUTER_LAB_SELF_EMAIL=
# Jev model the lab configures, when not the default.
# TINYCOMPUTER_LAB_JEV_MODEL=jev-latest
# A built module for the lab to load instead of its own release build.
# TINYCOMPUTER_MODULE=target/lab/libtinycomputer.dylib
# Where scripts/build-module installs it instead of <target>/lab: the loader
# refuses a module under a directory another user can write, so the Docker
# runners use $HOME/.local/lib/tinycomputer.
# TINYCOMPUTER_MODULE_DIR=

# The Jev debug journal (docs/technical/jev-journal.md): 1 writes every Jev exchange
# and timing under .jev-journal/ (git-ignored); any other value is the
# directory to write under. Off when unset.
# TINYCOMPUTER_JEV_JOURNAL=1
# How the live task examples ask Jev: `narrow` (the default) or `wide` —
# one request per turn over a digest of the screen (docs/technical/specs/jev-wide-turns.md).
# TINYCOMPUTER_FLOW_STRATEGY=wide
# How much the live task examples deliberate before acting: `deep` (the
# default), `standard`, or `off` (docs/technical/specs/jev-deliberation.md).
# TINYCOMPUTER_FLOW_DELIBERATION=off
# How the live browser examples read a page: by sight (the default), or
# `tree` for the accessibility tree alone (docs/technical/specs/browser-sight.md).
# TINYCOMPUTER_BROWSER_PERCEPTION=tree
# How a page settles after an action: prompt (default) or steady.
# TINYCOMPUTER_BROWSER_SETTLE=steady
# task_live: plan inside StartTask as OpenHuman does; the browser opens
# while it plans, at the one address the task names, unless PRELAUNCH is 0.
# TASK_PLAN=in-task
# TINYCOMPUTER_BROWSER_PRELAUNCH=0

# The on-screen cursor's overlay helper, when it is not beside the module.
# TINYCOMPUTER_CURSOR_OVERLAY=/path/to/tinycomputer-cursor-overlay

# Browser examples (task_live, task_fixture, browser_fixture): which browser
# to launch, how, or a running Chrome to attach to. task_live and task_fixture
# hand these to the module as its `browser` configuration.
# TINYCOMPUTER_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# TINYCOMPUTER_BROWSER_ARGS=--no-first-run
# TINYCOMPUTER_BROWSER_USER_AGENT=
# TINYCOMPUTER_BROWSER_ENDPOINT=http://127.0.0.1:9222
# Enforced browser egress refuses a launch if any of these ambient agent-browser
# variables are present. Unset them (including empty assignments) to use egress.
# AGENT_BROWSER_CDP=<unset>
# AGENT_BROWSER_AUTO_CONNECT=<unset>
# AGENT_BROWSER_PROVIDER=<unset>
# AGENT_BROWSER_ENGINE=<unset>
# AGENT_BROWSER_EXECUTABLE_PATH=<unset>
# AGENT_BROWSER_PROXY=<unset>
# AGENT_BROWSER_PROXY_BYPASS=<unset>
# AGENT_BROWSER_PROXY_USERNAME=<unset>
# AGENT_BROWSER_PROXY_PASSWORD=<unset>
# AGENT_BROWSER_PROFILE=<unset>
# AGENT_BROWSER_RESTORE=<unset>
# task_live: 1 shows the browser the task launches instead of running it
# headless (a headed run needs a display, so it runs on the host).
# TASK_HEADED=1
# task_live: 1 waits for the person at the terminal where only a person can
# go on (approve, log in or solve a captcha, type a missing detail, pay)
# instead of ending the run there.
# TASK_INTERACTIVE=1
# The travel fixture's address for browser_fixture.
# TINYCOMPUTER_FIXTURE_URL=http://127.0.0.1:8000
# task_live: a Tiny Humans bearer (a session token, or an API key with the
# `inference` scope) in place of OPENROUTER_API_KEY; Jev and the planner then
# go through Tiny Humans' routes, and openrouter/deepseek/deepseek-v4-flash
# plans, rescues, and shapes unless the model variables below name another.
# TINYHUMANS_TOKEN=
# The planner model task_live asks for.
# TINYCOMPUTER_PLANNER_MODEL=
# The reasoning model task_live rescues a failed step with (default
# openai/gpt-6-luna on OpenRouter), and how many rescues a task gets (0 to 5,
# default 5).
# TINYCOMPUTER_RESCUE_MODEL=
# TASK_RESCUES=5
# task_live: a file of elements earlier runs learned; read before the task,
# saved after it.
# TASK_MEMORY=target/task-live/memory/amazon.json
# The reasoning model task_live shapes a finished task's answer with
# (default openai/gpt-6-luna on OpenRouter), and a JSON TaskOutput file
# asking for it.
# TINYCOMPUTER_OUTPUT_MODEL=
# OUTPUT_FILE=crates/tinycomputer-examples/tasks/whatsapp/output.json
# Which decision model task_live's module asks: TINYCOMPUTER_DECISIONS=sage
# hands the module Levanto Sage (`jev.provider = "sage"`) with a Sage key;
# SAGE_FAST=1 scores a choice in one pass.
# TINYCOMPUTER_DECISIONS=sage
# SAGE_API_KEY=
# SAGE_FAST=1
# Where task_live runs: browser (default) or desktop, on this Mac's apps.
# TASK_SURFACE=desktop
# Opt-in live browser runs (see docs/technical/specs/unified-agent.md).
# TINYCOMPUTER_LIVE_BROWSER=1
# Compile and run the linked browser egress tests against installed Chromium.
# TINYCOMPUTER_LIVE_BROWSER_TESTS=1
# Compile and run TinyComputer's module-path egress tests against installed Chromium
# using only local fixture listeners:
# TINYCOMPUTER_LIVE_BROWSER_EGRESS_TESTS=1 cargo test --manifest-path crates/tinycomputer/Cargo.toml -p tinycomputer --lib --features static-link tinybus_module::browser_egress_live_tests -- --nocapture
